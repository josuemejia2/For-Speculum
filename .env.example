# DANZARIEL-QUERO / Lab local
# Copia este archivo como .env en cada PC y cambia el token.
DQ_SECRET_TOKEN=cambia-este-token
DQ_HOST=0.0.0.0
DQ_PORT=8000

# Carpeta local de memoria del servidor. Se mantiene fuera de Git.
DQ_DATA_DIR=danzariel_quero_data

# Variables antiguas opcionales. No pongas llaves reales en Git.
GOOGLE_API_KEY=your_google_api_key_here
PROJECT_ROOT=.
IGNORE_PATHS=env,.venv,__pycache__,.git,sistemas_viejos,danzariel_quero_data
